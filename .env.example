# Generate a random string with at least 32 characters.
# Keep this value private and set it in Vercel Project Settings > Environment Variables.
SESSION_PASSWORD=replace-with-a-random-secret-at-least-32-characters

# Password used to unlock the Atlantic Home dashboard (minimum 4 characters).
ATLANTIC_APP_PASSWORD=replace-with-a-private-app-password

# Optional: Neon Postgres connection string for cross-device energy history.
# Install Neon from the Vercel Marketplace and add its DATABASE_URL integration variable.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: shared secret for the scheduled GitHub Actions energy collector.
# Use the same random value in Vercel Environment Variables and GitHub Actions Secrets.
# CRON_SECRET=replace-with-a-separate-random-secret-at-least-32-characters

# Optional: official Tuya Cloud connection for a MYCOND OEM app/device.
# Link the MYCOND OEM app to a Tuya Cloud project first and grant device read/write access.
# Set these only as server-side Vercel environment variables; never expose them with NEXT_PUBLIC_.
# TUYA_ACCESS_ID=your-tuya-cloud-access-id
# TUYA_ACCESS_SECRET=your-tuya-cloud-access-secret
# TUYA_DEVICE_ID=device-id-from-the-linked-cloud-project
# TUYA_REGION=eu
