# Generate a random string with at least 32 characters.
# Keep this value private and set it in Vercel Project Settings > Environment Variables.
SESSION_PASSWORD=replace-with-a-random-secret-at-least-32-characters

# Password used to unlock the Atlantic Home dashboard (minimum 4 characters).
ATLANTIC_APP_PASSWORD=replace-with-a-private-app-password

# Optional: Neon Postgres connection string for cross-device energy history.
# Install Neon from the Vercel Marketplace and add its DATABASE_URL integration variable.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
